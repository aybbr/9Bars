# 9Bars environment configuration.
# Copy to `.env` for local overrides. Never commit real secrets; this file
# contains only safe defaults.

NINE_BARS_ENVIRONMENT=development
NINE_BARS_HOST=0.0.0.0
NINE_BARS_PORT=9009
NINE_BARS_LOG_LEVEL=info

# Embedded DuckDB database path (relative to the project root).
NINE_BARS_DUCKDB_PATH=data/nine_bars.duckdb

# Device boundary: set to a live machine host to talk to it over HTTP/WS
# (e.g. "gaggimate.local"). Leave unset to replay the committed fixture shots.
# NINE_BARS_DEVICE_HOST=

# Coffee research model provider (issue #7). DeepSeek's API is OpenAI-compatible.
# Leave DEEPSEEK_API_KEY unset to run the researcher in no-fabrication offline mode.
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# NINE_BARS_DEEPSEEK_BASE_URL=https://api.deepseek.com
# NINE_BARS_DEEPSEEK_MODEL=deepseek-flash
# NINE_BARS_RESEARCH_TIMEOUT_S=10.0

# Model provider (future). Leave unset to use Strands' default (Amazon Bedrock).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
